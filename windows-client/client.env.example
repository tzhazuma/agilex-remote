# Example machine-local settings. Copy to client.env and edit.
# CLI options and environment variables override this file.
#
# Do NOT put private key contents here. Only a path is needed.

AGILEX_HOST=192.168.1.50
AGILEX_USER=agilex
AGILEX_IDENTITY_FILE=C:\Users\<you>\.ssh\id_ed25519_robot

